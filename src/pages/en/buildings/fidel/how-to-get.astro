---
import BuildingLayout from '@layouts/BuildingLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ContactCTA from '@components/ContactCTA.astro';
import InteractiveMapIsland from '@components/InteractiveMapIsland.astro';
import { getBuildingBySlug } from '@data/buildings';
import { getBuildingEnBySlug } from '@data/buildings-en';

const building = getBuildingBySlug('fidel')!;
const en = getBuildingEnBySlug('fidel')!;

const title = `How to Get to BC ${en.name} — Directions | ANM`;
const description = `How to get to ${en.name} Business Center. Metro ${en.metro.name} — ${building.metro[0].walkingMinutes} min walk. Driving directions.`;
---

<BuildingLayout
  title={title}
  description={description}
  buildingName={en.name}
  buildingSlug={building.slug}
>
  <PageHeader eyebrow="Getting here" title={`How to Get to BC ${en.name}`} lead={en.address} />

  <section class="section section--flush">
    <div class="container">

      <div class="how-to-get-grid">
        <div class="how-to-get-grid__info">
          <div class="direction-block">
            <h3>By Metro</h3>
            {building.metro.map((m) => (
              <div class="direction-item">
                <span class="direction-dot" style={`background-color: ${m.lineColor}`}></span>
                <div>
                  <strong>{en.metro.name}</strong>
                  <span class="text-caption"> — {en.metro.line}</span>
                  <p class="text-caption">{m.walkingMinutes} minutes walk from the station</p>
                </div>
              </div>
            ))}
            <p class="direction-detail">
              Exit the metro, turn right and walk along Pr. Obukhovskoy Oborony in the direction of increasing house numbers. In 9 minutes you will see the entrance to the business center territory.
            </p>
          </div>

          <div class="direction-block">
            <h3>By Car</h3>
            <div class="direction-item">
              <strong>From Nevsky Prospekt</strong>
              <p class="text-caption">~15 minutes. Drive along Nevsky Prospekt towards Aleksandr Nevsky Lavra, then along Pr. Obukhovskoy Oborony.</p>
            </div>
            <div class="direction-item">
              <strong>From the Ring Road (KAD)</strong>
              <p class="text-caption">~10 minutes. Exit onto Pr. Obukhovskoy Oborony.</p>
            </div>
          </div>

          <div class="direction-block">
            <h3>Parking</h3>
            <p>Guarded well-lit parking with 218 spaces. Entrance from Pr. Obukhovskoy Oborony.</p>
          </div>

          <div class="direction-block">
            <h3>Build a Route</h3>
            <div class="route-buttons">
              <a href={`https://2gis.ru/spb/directions/points/~${building.coordinates.lng},${building.coordinates.lat}`} target="_blank" rel="noopener noreferrer" class="route-btn route-btn--2gis">
                <svg class="route-btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                2GIS
              </a>
              <a href={`https://yandex.ru/maps/?rtext=~${building.coordinates.lat},${building.coordinates.lng}&rtt=auto`} target="_blank" rel="noopener noreferrer" class="route-btn route-btn--yandex">
                <svg class="route-btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                Yandex Maps
              </a>
            </div>
          </div>
        </div>

        <div class="how-to-get-grid__map">
          <InteractiveMapIsland
            markers={[{
              lat: building.coordinates.lat,
              lng: building.coordinates.lng,
              title: `BC ${en.name}`,
              address: en.shortAddress,
              href: `/en/buildings/${building.slug}/`,
            }]}
            center={building.coordinates}
            zoom={16}
            height="100%"
          />
        </div>
      </div>
    </div>
  </section>

  <ContactCTA />
</BuildingLayout>

<style>
  .how-to-get-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-2xl);
    align-items: stretch;
  }

  .how-to-get-grid__info {
    grid-column: 1 / 6;
    border-top: 1px solid var(--color-line-strong);
  }

  .how-to-get-grid__map {
    grid-column: 7 / 13;
    min-height: 32rem;
  }

  .direction-block {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .direction-block h3 {
    margin-bottom: 1rem;
    font-size: var(--text-caption);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  .direction-block p {
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .direction-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.9rem;
    font-size: 1.0625rem;
  }

  .direction-item:has(.direction-dot) {
    flex-direction: row;
    align-items: baseline;
    gap: 0.6rem;
  }

  .direction-item strong {
    font-weight: var(--weight-regular);
  }

  .direction-item p {
    margin: 0.25rem 0 0;
  }

  .direction-dot {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    transform: translateY(-1px);
  }

  .direction-detail {
    margin: 0.5rem 0 0;
  }

  .route-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .route-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .route-btn:hover {
    color: #fff;
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .route-btn__icon {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 1023px) {
    .how-to-get-grid__info,
    .how-to-get-grid__map {
      grid-column: 1 / 13;
    }

    .how-to-get-grid__map {
      min-height: 22rem;
    }
  }
</style>

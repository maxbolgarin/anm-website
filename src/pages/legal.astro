---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { contactInfo } from '@data/navigation';

const title = 'Раскрытие информации — АНМ';
const description = 'Юридическая информация, реквизиты и раскрытие информации ООО «Александро-Невская Мануфактура».';

const breadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Раскрытие информации' },
];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section legal-page">
    <div class="container legal-content">
      <h1>Раскрытие информации</h1>

      <h2>Общие сведения</h2>
      <p>
        ООО «Александро-Невская Мануфактура» осуществляет деятельность по управлению коммерческой недвижимостью на территории Санкт-Петербурга.
      </p>

      <h2 id="requisites">Реквизиты</h2>
      <table class="legal-table">
        <tbody>
          <tr>
            <td>Полное наименование</td>
            <td>ООО «Александро-Невская Мануфактура»</td>
          </tr>
          <tr>
            <td>Сокращённое наименование</td>
            <td>ООО «АНМ»</td>
          </tr>
          <tr>
            <td>ИНН</td>
            <td>7811185789</td>
          </tr>
          <tr>
            <td>КПП</td>
            <td>781101001</td>
          </tr>
          <tr>
            <td>ОКПО</td>
            <td>74770280</td>
          </tr>
          <tr>
            <td>Расчётный счёт</td>
            <td>40702810355000100961</td>
          </tr>
          <tr>
            <td>Банк</td>
            <td>Северо-Западный банк ПАО «Сбербанк России»</td>
          </tr>
          <tr>
            <td>К/с</td>
            <td>30101810500000000653</td>
          </tr>
          <tr>
            <td>БИК</td>
            <td>044030653</td>
          </tr>
          <tr>
            <td>Юридический адрес</td>
            <td>192029, г. Санкт-Петербург, пр. Обуховской Обороны, дом 70, корпус 2, литер А</td>
          </tr>
          <tr>
            <td>Телефон</td>
            <td><a href={contactInfo.phoneHref}>{contactInfo.phone}</a></td>
          </tr>
          <tr>
            <td>Email</td>
            <td><a href={contactInfo.emailHref}>{contactInfo.email}</a></td>
          </tr>
        </tbody>
      </table>

      <h2>Политика конфиденциальности</h2>
      <p>
        Настоящий сайт не собирает персональные данные посетителей. На сайте отсутствуют формы сбора персональных данных, системы авторизации и личные кабинеты. Все контактные данные, размещённые на сайте, являются публичными контактами компании.
      </p>

      <h2>Правовая информация</h2>
      <p>
        Информация, размещённая на данном сайте, носит информационный характер и не является публичной офертой. Для получения актуальных условий аренды обращайтесь в коммерческий отдел по телефону <a href={contactInfo.commercialHref}>{contactInfo.commercial}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .legal-content > * {
    max-width: 52rem;
  }

  .legal-content h1 {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    letter-spacing: -0.04em;
  }

  .legal-content h2 {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 1.25rem;
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .legal-content p,
  .legal-content li {
    font-size: var(--text-small);
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .legal-table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--color-line-strong);
  }

  .legal-table td {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-small);
    vertical-align: top;
  }

  .legal-table td:first-child {
    width: 40%;
    padding-right: var(--space-lg);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .legal-table td {
      display: block;
      width: 100% !important;
      padding: 0.25rem 0;
      border: 0;
    }

    .legal-table tr {
      display: block;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-line);
    }
  }
</style>

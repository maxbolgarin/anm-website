---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SectionHeading from '@components/SectionHeading.astro';
import FacilityCard from '@components/FacilityCard.astro';
import InteractiveMapIsland from '@components/InteractiveMapIsland.astro';
import TerritoryMapIsland from '@components/TerritoryMapIsland.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { buildings } from '@data/buildings';
import { withBase } from '@utils/withBase';

const title = 'Локация — АНМ';
const description = 'Локация Александро-Невской Мануфактуры: два бизнес-центра на набережной Невы, развитая инфраструктура, паркинг, кафе, фитнес, охрана 24/7.';

const breadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: 'О компании', href: '/about/' },
  { label: 'Локация' },
];

const mapMarkers = buildings.map((b) => ({
  lat: b.coordinates.lat,
  lng: b.coordinates.lng,
  title: b.name.startsWith('БЦ') ? b.name : `БЦ ${b.name}`,
  address: b.shortAddress,
  href: `/buildings/${b.slug}/`,
}));

const facilityItems = [
  {
    name: 'Охраняемый паркинг',
    description: 'Охраняемый освещённый паркинг. Гостевые места и абонементы.',
    image: '/images/infrastructure/parking-aerial.jpg',
    imageAlt: 'Паркинг на территории Александро-Невской Мануфактуры',
  },
  {
    name: 'Фитнес-студия',
    description: 'Современный тренажёрный зал. Специальные условия для арендаторов.',
    image: '/фото бц/image_2026-04-23_13-54-55 (1).png',
    imageAlt: 'Фитнес-студия на территории бизнес-центра',
  },
  {
    name: 'Столовые и кафе',
    description: '2 столовые с комплексными обедами, 2 кафе со свежим кофе и лёгкими перекусами.',
    image: '/images/buildings/anm/abk-cafe-new.jpg',
    imageAlt: 'Кафе на территории Александро-Невской Мануфактуры',
  },
];

const managementServices = [
  { name: 'Техническое обслуживание', description: 'Собственная служба эксплуатации. Электрики, сантехники, инженеры — на месте 24/7.' },
  { name: 'Клининг', description: 'Профессиональная уборка общих зон и офисов. Ежедневно и по запросу.' },
  { name: 'Охрана и безопасность', description: 'Круглосуточная охрана, видеонаблюдение, контроль доступа по картам.' },
  { name: 'Пропускная система', description: 'Электронные пропуска для сотрудников и гостей. Заказ через личный кабинет.' },
  { name: 'Служба заботы', description: 'Одна точка контакта для всех вопросов. Быстрое решение любых задач.' },
  { name: 'Бронирование переговорных', description: 'Современные переговорные комнаты. Онлайн-бронирование для арендаторов.' },
];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <!-- ===== SECTION 1: TERRITORY MAP ===== -->
  <section class="section territory-map" id="map">
    <div class="container">
      <SectionHeading
        title="Локация"
        subtitle="Александро-Невская Мануфактура — это два бизнес-центра на исторической территории у набережной Невы с развитой инфраструктурой для комфортной работы."
      />
    </div>
    <div class="map-section">
      <InteractiveMapIsland
        markers={mapMarkers}
        center={{ lat: 59.9010, lng: 30.4295 }}
        zoom={16}
        height="480px"
      />
    </div>
  </section>

  <!-- ===== SECTION 3: INFRASTRUCTURE ===== -->
  <section class="section section--cream" id="infrastructure">
    <div class="container">
      <div class="infra-header">
        <h2 class="infra-header__title">Всё необходимое на территории</h2>
        <p class="infra-header__subtitle">
          Вашим сотрудникам не нужно выходить за территорию. Питание, спорт, парковка — всё в шаговой доступности.
        </p>
      </div>
      <div class="territory-scheme">
        <TerritoryMapIsland />
      </div>
      <div class="infra-grid">
        {facilityItems.map((item) => (
          <FacilityCard
            name={item.name}
            description={item.description}
            image={item.image}
            imageAlt={item.imageAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SECTION 4: MANAGEMENT COMPANY ===== -->
  <section class="section" id="management">
    <div class="container">
      <SectionHeading
        title="Управляющая компания"
        subtitle="Собственная управляющая компания с 20-летним опытом. Мы знаем, что нужно вашему бизнесу."
        align="center"
      />
      <div class="mgmt-grid">
        {managementServices.map((svc, i) => (
          <div class="mgmt-card">
            <span class="mgmt-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mgmt-card__name">{svc.name}</h3>
            <p class="mgmt-card__desc">{svc.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SECTION 5: CONTACT CTA ===== -->
  <ContactCTA />
</BaseLayout>

<style>
  /* Map section */
  .territory-map {
    padding-top: var(--space-xl);
  }

  .map-section {
    margin-top: var(--space-xl);
  }

  /* Infrastructure header */
  .infra-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .infra-header__label {
    display: inline-block;
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .infra-header__title {
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-md);
  }

  .infra-header__subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
  }

  /* Territory scheme */
  .territory-scheme {
    margin-bottom: var(--space-3xl);
  }

  /* Infrastructure grid — 3 columns */
  .infra-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  /* Infrastructure card */
  /* Management company section */
  .mgmt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .mgmt-card {
    background-color: var(--color-surface-cream);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    transition: box-shadow 0.2s ease;
  }

  .mgmt-card:hover {
    box-shadow: var(--shadow-md);
  }

  .mgmt-card__num {
    display: block;
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-lg);
  }

  .mgmt-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-sm);
  }

  .mgmt-card__desc {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 1023px) {
    .infra-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .mgmt-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .infra-grid {
      grid-template-columns: 1fr;
    }

    .mgmt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

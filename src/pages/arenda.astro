---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import OfficeFilterIsland from '@components/OfficeFilterIsland.astro';
import ContactCTA from '@components/ContactCTA.astro';

const title = 'Аренда офисов — свободные помещения в бизнес-центрах АНМ';
const description = 'Актуальные предложения аренды офисов в бизнес-центрах Фидель и БЦ АНМ на территории Александро-Невской Мануфактуры. Подберите офис по площади, этажу и бюджету.';

const breadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Аренда' },
];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="arenda">
    <div class="container">
      <div class="arenda__intro">
        <h1 class="arenda__title">Аренда офисов</h1>
        <p class="arenda__subtitle">Свободные площади в бизнес-центрах Фидель и АНМ на территории Александро-Невской Мануфактуры</p>
      </div>

      <OfficeFilterIsland />
    </div>
  </section>

  <!-- ===== CONTACT CTA ===== -->
  <ContactCTA />
</BaseLayout>

<style>
  .arenda {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-4xl);
  }

  .arenda__intro {
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-2xl);
    border-bottom: 2px solid var(--color-primary);
  }

  .arenda__title {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .arenda__subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    margin-top: var(--space-md);
    max-width: 38rem;
    line-height: var(--leading-normal);
  }

  @media (max-width: 767px) {
    .arenda__intro {
      margin-bottom: var(--space-xl);
    }
  }
</style>

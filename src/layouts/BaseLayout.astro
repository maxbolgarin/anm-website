---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { withBase } from '@utils/withBase';
import { getLocaleFromPath, getLocalePath } from '@utils/locale';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object | object[];
  /** Header floats transparently over a full-bleed hero (home page) */
  headerOverlay?: boolean;
}

const {
  title,
  description,
  ogImage = '/territory/anm-top-poster.jpg',
  canonicalUrl,
  jsonLd,
  headerOverlay = false,
} = Astro.props;

const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://www.a-n-m.ru';
const canonical = canonicalUrl || `${siteUrl}${currentPath}`;

// Build hreflang alternate paths
const ruPath = locale === 'ru' ? currentPath : `${siteUrl}${withBase(getLocalePath(currentPath, 'ru'))}`;
const enPath = locale === 'en' ? currentPath : `${siteUrl}${withBase(getLocalePath(currentPath, 'en'))}`;
const ruHref = locale === 'ru' ? `${siteUrl}${currentPath}` : ruPath;
const enHref = locale === 'en' ? `${siteUrl}${currentPath}` : enPath;

const ogLocale = locale === 'en' ? 'en_US' : 'ru_RU';

// Organization JSON-LD (appears on every page)
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "АНМ",
  "alternateName": "Aleksandro-Nevskaya Manufaktura",
  "url": siteUrl,
  "telephone": "+7-812-313-18-04",
  "email": "mail@ukanm.ru",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Пр. Обуховской Обороны д. 70, корпус 2, лит А",
    "addressLocality": "Санкт-Петербург",
    "addressCountry": "RU"
  }
};
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#141414" />
  <script is:inline>document.documentElement.classList.add('js');</script>

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ru" href={ruHref} />
  <link rel="alternate" hreflang="en" href={enHref} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${withBase(ogImage)}`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />

  <!-- Fonts: Montserrat (variable) via @font-face in typography.css — preload the primary subsets -->
  <link rel="preload" href={withBase('/fonts/Montserrat-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={withBase('/fonts/Montserrat-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <meta property="og:site_name" content={locale === 'en' ? 'Aleksandro-Nevskaya Manufaktura' : 'Александро-Невская Мануфактура'} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- JSON-LD: Organization -->
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

  <!-- JSON-LD: Page-specific -->
  {jsonLdList.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
</head>
<body class:list={{ 'has-header-overlay': headerOverlay }}>
  <a href="#main" class="skip-link">{locale === 'en' ? 'Skip to content' : 'Перейти к содержанию'}</a>
  <Header currentPath={currentPath} overlay={headerOverlay} />

  <main id="main">
    <slot />
  </main>

  <Footer />

  <script>
    // Scroll reveal — fades [data-reveal] elements in once as they enter the viewport
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window && els.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-revealed');
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-revealed'));
    }
  </script>
</body>
</html>

---
/**
 * Home page (RU + EN share this view — pages/index.astro and pages/en/index.astro).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import BuildingShowcase from '@components/home/BuildingShowcase.astro';
import AmenitiesIndex from '@components/home/AmenitiesIndex.astro';
import CompanyTeaser from '@components/home/CompanyTeaser.astro';
import TerritoryMapIsland from '@components/TerritoryMapIsland.astro';
import LocationContacts from '@components/LocationContacts.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getShowcase } from '@data/showcase';
import { buildings } from '@data/buildings';
import { withBase } from '@utils/withBase';
import { absoluteUrl } from '@utils/seo';
import type { Locale } from '@utils/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const prefix = isEn ? '/en' : '';
const showcase = getShowcase(locale);

const t = isEn
  ? {
      title: 'Office Rental near Elizarovskaya Metro, St. Petersburg — Business Centers on the Neva | ANM',
      description: 'Office rental near Elizarovskaya metro in St. Petersburg: Business Loft Fidel (class B+) and Business Center ANM on the Neva, a 9-minute walk, 328 parking spaces, 24/7 access. Direct lease from the owner.',
      mapEyebrow: 'Territory',
      mapTitle: 'One territory — two business centers',
      mapLink: 'More about the location',
      disclosure: 'Information disclosure',
      disclosureText: 'Information subject to disclosure in accordance with the legislation of the Russian Federation.',
      disclosureLink: 'Full information',
    }
  : {
      title: 'Аренда офисов у м. Елизаровская — бизнес-центры на Неве в Санкт-Петербурге | АНМ',
      description: 'Аренда офисов у метро Елизаровская: бизнес-лофт Фидель (класс B+) и бизнес-центр АНМ на набережной Невы, 9 минут пешком, 328 машиномест, доступ 24/7. Прямая аренда от собственника.',
      mapEyebrow: 'Территория',
      mapTitle: 'Одна территория — два бизнес-центра',
      mapLink: 'Подробнее о локации',
      disclosure: 'Раскрытие информации',
      disclosureText: 'Информация, подлежащая раскрытию в соответствии с законодательством Российской Федерации.',
      disclosureLink: 'Полная информация',
    };

// Structured data: the two buildings as places offering office space
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: isEn ? 'ANM business centers' : 'Бизнес-центры АНМ',
  itemListElement: buildings.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Place',
      name: showcase.find((s) => s.slug === b.slug)?.title ?? b.name,
      url: absoluteUrl(`${prefix}/buildings/${b.slug}/`),
      address: {
        '@type': 'PostalAddress',
        streetAddress: b.address,
        addressLocality: isEn ? 'Saint Petersburg' : 'Санкт-Петербург',
        addressCountry: 'RU',
      },
      geo: { '@type': 'GeoCoordinates', latitude: b.coordinates.lat, longitude: b.coordinates.lng },
    },
  })),
};
---

<BaseLayout title={t.title} description={t.description} jsonLd={jsonLd} headerOverlay>
  <HomeHero locale={locale} />

  <div id="buildings" class="buildings-anchor">
    {showcase.map((b, i) => (
      <BuildingShowcase locale={locale} building={b} first={i === 0} />
    ))}
  </div>

  <div class="spacer" aria-hidden="true"></div>

  <AmenitiesIndex locale={locale} />

  <section class="section map-block" id="territory-map" aria-labelledby="map-title">
    <div class="container">
      <div class="map-block__head" data-reveal>
        <span class="eyebrow">{t.mapEyebrow}</span>
        <h2 class="map-block__title" id="map-title">{t.mapTitle}</h2>
      </div>
      <TerritoryMapIsland />
      <div class="map-block__foot">
        <a href={withBase(`${prefix}/territory/`)} class="link-arrow">{t.mapLink}</a>
      </div>
    </div>
  </section>

  <CompanyTeaser locale={locale} />

  <LocationContacts />

  <section class="disclosure" id="disclosure">
    <div class="container">
      <details class="disclosure__details">
        <summary class="disclosure__summary">{t.disclosure}</summary>
        <p class="disclosure__content">
          {t.disclosureText} <a href={withBase(`${prefix}/legal/`)}>{t.disclosureLink}</a>
        </p>
      </details>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .buildings-anchor {
    scroll-margin-top: var(--header-height);
  }

  .spacer {
    height: var(--section-space);
  }

  .map-block__head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .map-block__head .eyebrow {
    margin-bottom: 1rem;
  }

  .map-block__title {
    max-width: 24ch;
    font-size: var(--text-h2);
  }

  .map-block__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .disclosure {
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .disclosure__summary {
    cursor: pointer;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    list-style-position: inside;
  }

  .disclosure__content {
    margin: var(--space-md) 0 0;
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .map-block__foot {
      justify-content: flex-start;
    }
  }
</style>

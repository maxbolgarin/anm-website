    grid-column: 1 / 6;
  }

  .loc-b__rows {
    margin: var(--space-xl) 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .loc-b__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-md);
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line-strong);
    font-size: var(--text-small);
  }

  .loc-b__row dt {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    padding-top: 0.1rem;
  }

  .loc-b__row dd {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .loc-b__row dd:has(.bh__dot) {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }

  .loc-b__map {
    grid-column: 7 / 13;
  }

  /* ── Responsive ── */

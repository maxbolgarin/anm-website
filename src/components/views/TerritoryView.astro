---
/**
 * Location & territory page (RU + EN).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import Img from '@components/Img.astro';
import TerritoryMapIsland from '@components/TerritoryMapIsland.astro';
import InteractiveMapIsland from '@components/InteractiveMapIsland.astro';
import AmenitiesIndex from '@components/home/AmenitiesIndex.astro';
import ManagementServices from '@components/sections/ManagementServices.astro';
import LocationContacts from '@components/LocationContacts.astro';
import ContactCTA from '@components/ContactCTA.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import { buildings } from '@data/buildings';
import type { Locale } from '@utils/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const prefix = isEn ? '/en' : '';

const t = isEn
  ? {
      title: 'Offices near Elizarovskaya Metro — Location & Territory | ANM',
      description: 'Offices a 9-minute walk from Elizarovskaya metro, St. Petersburg: two business centers on the historic Neva embankment with 328 parking spaces, cafés, fitness and 24/7 security.',
      crumbs: [{ label: 'Home', href: '/en/' }, { label: 'About', href: '/en/about/' }, { label: 'Location' }],
      eyebrow: 'Location',
      h1: 'A historic territory on the Neva',
      lead: 'Aleksandro-Nevskaya Manufaktura brings together two business centers on the Neva embankment, with everything your team needs within a few steps.',
      facts: [
        { value: '9 min', label: 'walk from Elizarovskaya metro' },
        { value: '328', label: 'parking spaces' },
        { value: '24/7', label: 'access and security' },
      ],
      caption: 'the territory from above, golden hour',
      alt: 'Aerial view of the territory with the Neva and the city skyline',
      mapEyebrow: 'Interactive map',
      mapTitle: 'Explore the territory',
      mapLead: 'Filter by category to find cafés, parking, fitness, recreation areas and building entrances.',
      cityEyebrow: 'In the city',
      cityTitle: 'On the map of St. Petersburg',
      bc: (n: string) => `Business center ${n}`,
      faqEyebrow: 'FAQ',
      faqTitle: 'Offices near Elizarovskaya: frequently asked\u00a0questions',
      faq: [
        {
          question: 'How far are the offices from Elizarovskaya metro station?',
          answer: 'About a 9-minute walk. Exit the metro, turn right and walk along Pr. Obukhovskoy Oborony in the direction of increasing house numbers until you reach the entrance to the territory at No. 70.',
        },
        {
          question: 'Where exactly is the territory?',
          answer: 'Pr. Obukhovskoy Oborony, 70, Nevsky District, St. Petersburg — on the Neva embankment. Business Loft Fidel is at No. 70, Business Center ANM at No. 70 bldg. 2.',
        },
        {
          question: 'What kind of offices are available?',
          answer: 'Two business centers on one territory: Business Loft Fidel (class B+, a historic 1855 building with ceilings up to 4.2 m) and Business Center ANM (class B). Private offices and open-plan spaces of different sizes are available; see the Rent page for the current list.',
        },
        {
          question: 'Is there parking?',
          answer: 'Yes. The territory has 328 secured parking spaces: 218 at Business Loft Fidel and 110 at Business Center ANM, plus guest spaces.',
        },
        {
          question: 'What is on the territory besides offices?',
          answer: 'Cafés and canteens, a fitness studio, meeting rooms, a reception, 24/7 security with card access, and the Neva embankment for walks and outdoor meetings.',
        },
        {
          question: 'What is the minimum lease term and who is the landlord?',
          answer: 'The standard minimum term is 11 months. You lease directly from the owner, the management company Aleksandro-Nevskaya Manufaktura.',
        },
        {
          question: 'How do I arrange a viewing?',
          answer: 'Call the commercial department at +7 (812) 336-55-64 or write to arenda@ukanm.ru — we will show you the available offices at a convenient time.',
        },
      ],
    }
  : {
      title: 'Офисы у метро Елизаровская — локация и территория АНМ | Санкт-Петербург',
      description: 'Офисы в 9 минутах пешком от метро Елизаровская: два бизнес-центра на набережной Невы в Невском районе, 328 машиномест, кафе, фитнес, охрана 24/7. Как добраться и что есть на территории.',
      crumbs: [{ label: 'Главная', href: '/' }, { label: 'О компании', href: '/about/' }, { label: 'Локация' }],
      eyebrow: 'Локация',
      h1: 'Историческая территория на Неве',
      lead: 'Александро-Невская Мануфактура — два бизнес-центра на набережной Невы и всё необходимое для работы в шаговой доступности.',
      facts: [
        { value: '9 мин', label: 'пешком от м. Елизаровская' },
        { value: '328', label: 'машиномест' },
        { value: '24/7', label: 'доступ и охрана' },
      ],
      caption: 'территория с высоты, закат',
      alt: 'Территория Александро-Невской Мануфактуры и Нева с высоты',
      mapEyebrow: 'Интерактивная карта',
      mapTitle: 'Изучите территорию',
      mapLead: 'Фильтруйте по категориям: кафе, паркинг, фитнес, зоны отдыха и входы в здания.',
      cityEyebrow: 'В городе',
      cityTitle: 'На карте Санкт-Петербурга',
      bc: (n: string) => (n.startsWith('БЦ') ? n : `БЦ ${n}`),
      faqEyebrow: 'Вопросы',
      faqTitle: 'Офисы у\u00a0м.\u00a0Елизаровская: частые вопросы',
      faq: [
        {
          question: 'Сколько идти до офисов от метро Елизаровская?',
          answer: 'Около 9 минут пешком. Выйдите из метро, поверните направо и идите по пр. Обуховской Обороны в сторону увеличения нумерации домов до входа на территорию у дома 70.',
        },
        {
          question: 'Где находится территория?',
          answer: 'Санкт-Петербург, Невский район, пр. Обуховской Обороны, 70 — на набережной Невы. Бизнес-лофт Фидель — дом 70, бизнес-центр АНМ — дом 70, корпус 2.',
        },
        {
          question: 'Какие офисы можно арендовать?',
          answer: 'На одной территории два бизнес-центра: бизнес-лофт Фидель (класс B+, исторический корпус 1855 года с потолками до 4,2 м) и бизнес-центр АНМ (класс B). Доступны кабинеты и помещения открытой планировки разной площади — актуальный список на странице «Аренда».',
        },
        {
          question: 'Есть ли парковка?',
          answer: 'Да. На территории 328 охраняемых машиномест: 218 у бизнес-лофта Фидель и 110 у бизнес-центра АНМ, а также гостевые места.',
        },
        {
          question: 'Что есть на территории, кроме офисов?',
          answer: 'Кафе и столовые, фитнес-студия, переговорные, ресепшн, круглосуточная охрана с доступом по картам и набережная Невы для прогулок и встреч на свежем воздухе.',
        },
        {
          question: 'Какой минимальный срок аренды и кто арендодатель?',
          answer: 'Стандартный минимальный срок — 11 месяцев. Аренда напрямую от собственника — управляющей компании «Александро-Невская Мануфактура».',
        },
        {
          question: 'Как договориться о просмотре?',
          answer: 'Позвоните в коммерческий отдел по телефону +7 (812) 336-55-64 или напишите на arenda@ukanm.ru — покажем свободные офисы в удобное время.',
        },
      ],
    };

const mapMarkers = buildings.map((b) => ({
  lat: b.coordinates.lat,
  lng: b.coordinates.lng,
  title: t.bc(b.name),
  address: b.shortAddress,
  href: `${prefix}/buildings/${b.slug}/`,
}));
---

<BaseLayout title={t.title} description={t.description} ogImage="/images/v2/territory-aerial-3.jpg">
  <PageHeader breadcrumbs={t.crumbs} eyebrow={t.eyebrow} title={t.h1} lead={t.lead}>
    <dl class="facts" slot="aside">
      {t.facts.map((f) => (
        <div class="facts__item">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </PageHeader>

  <figure class="aerial container-wide figure" data-reveal>
    <div class="aerial__frame">
      <Img name="territory-aerial-3" alt={t.alt} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <figcaption class="figure__caption">{t.caption}</figcaption>
  </figure>

  <section class="section" id="map" aria-labelledby="tmap-title">
    <div class="container">
      <div class="split-head" data-reveal>
        <div>
          <span class="eyebrow">{t.mapEyebrow}</span>
          <h2 id="tmap-title">{t.mapTitle}</h2>
        </div>
        <p>{t.mapLead}</p>
      </div>
      <TerritoryMapIsland />
    </div>
  </section>

  <AmenitiesIndex locale={locale} />

  <ManagementServices locale={locale} />

  <section class="section" aria-labelledby="city-title">
    <div class="container">
      <div class="split-head" data-reveal>
        <div>
          <span class="eyebrow">{t.cityEyebrow}</span>
          <h2 id="city-title">{t.cityTitle}</h2>
        </div>
      </div>
    </div>
    <div class="container-wide">
      <InteractiveMapIsland markers={mapMarkers} center={{ lat: 59.9010, lng: 30.4295 }} zoom={15} height="480px" />
    </div>
  </section>

  <FaqSection items={t.faq} eyebrow={t.faqEyebrow} title={t.faqTitle} />

  <LocationContacts />

  <ContactCTA />
</BaseLayout>

<style>
  .facts {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .facts__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }

  .facts__item dt {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .facts__item dd {
    font-size: 1.5rem;
    font-weight: var(--weight-light);
    letter-spacing: -0.02em;
  }

  .aerial__frame {
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  .aerial__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aerial .figure__caption {
    text-align: right;
  }

  .split-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-md);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .split-head > div {
    grid-column: 1 / 8;
  }

  .split-head .eyebrow {
    margin-bottom: 1rem;
  }

  .split-head h2 {
    font-size: var(--text-h2);
  }

  .split-head p {
    grid-column: 8 / 13;
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1023px) {
    .split-head > div,
    .split-head p {
      grid-column: 1 / 13;
    }

    .aerial__frame {
      aspect-ratio: 16 / 10;
    }
  }
</style>

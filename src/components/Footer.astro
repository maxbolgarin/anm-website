---
import { buildingNav, buildingNavEn, contactInfo } from '@data/navigation';
import { withBase } from '@utils/withBase';
import { getLocaleFromPath } from '@utils/locale';

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isEn = locale === 'en';
const bNav = isEn ? buildingNavEn : buildingNav;
const prefix = isEn ? '/en' : '';
const logoMask = `url('${withBase('/images/common/logo-icon.svg')}')`;

const t = isEn
  ? {
      lead: 'A business cluster\non the historic Neva embankment',
      commercial: 'Leasing department',
      main: 'Main line',
      buildings: 'Business centers',
      company: 'Company',
      about: 'About ANM',
      history: 'Company & history',
      location: 'Location',
      rent: 'Office rental',
      contacts: 'Contacts',
      address: 'Saint Petersburg, Obukhovskoy Oborony Ave. 70, bldg. 2, lit. A',
      rights: 'ANM. All rights reserved.',
      legal: 'Information disclosure',
      requisites: 'Company details',
      names: { fidel: 'Business Loft Fidel', anm: 'Business Center ANM' } as Record<string, string>,
    }
  : {
      lead: 'Бизнес-кластер\nна исторической набережной Невы',
      commercial: 'Коммерческий отдел',
      main: 'Основной телефон',
      buildings: 'Бизнес-центры',
      company: 'Компания',
      about: 'О компании',
      history: 'Компания и история',
      location: 'Локация',
      rent: 'Аренда офисов',
      contacts: 'Контакты',
      address: contactInfo.address,
      rights: 'АНМ. Все права защищены.',
      legal: 'Раскрытие информации',
      requisites: 'Реквизиты',
      names: { fidel: 'Бизнес-лофт Фидель', anm: 'Бизнес-центр АНМ' } as Record<string, string>,
    };
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__contact">
        <p class="footer__lead">{t.lead}</p>
        <span class="footer__label">{t.commercial}</span>
        <a href={contactInfo.commercialHref} class="footer__phone">{contactInfo.commercial}</a>
        <div class="footer__meta">
          <a href={contactInfo.emailHref} class="footer__meta-link">{contactInfo.email}</a>
          <a href={contactInfo.phoneHref} class="footer__meta-link">{contactInfo.phone}</a>
          <span class="footer__address">{t.address}</span>
        </div>
      </div>

      <a href={withBase(isEn ? '/en/' : '/')} class="footer__mark" aria-label={isEn ? 'ANM — Home' : 'АНМ — Главная'} style={`--logo-mask: ${logoMask}`}></a>
    </div>

    <nav class="footer__nav" aria-label={isEn ? 'Footer navigation' : 'Навигация в подвале'}>
      <div class="footer__col">
        <h2 class="footer__heading">{t.buildings}</h2>
        <ul class="footer__list">
          {bNav.map((b) => (
            <li><a href={withBase(b.href)} class="footer__link">{t.names[b.slug] ?? b.name}</a></li>
          ))}
          <li><a href={withBase(`${prefix}/arenda/`)} class="footer__link">{t.rent}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">{t.company}</h2>
        <ul class="footer__list">
          <li><a href={withBase(`${prefix}/about/`)} class="footer__link">{t.about}</a></li>
          <li><a href={withBase(`${prefix}/about/company/`)} class="footer__link">{t.history}</a></li>
          <li><a href={withBase(`${prefix}/territory/`)} class="footer__link">{t.location}</a></li>
          <li><a href={withBase(`${prefix}/contacts/`)} class="footer__link">{t.contacts}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">{isEn ? 'Legal' : 'Документы'}</h2>
        <ul class="footer__list">
          <li><a href={withBase(`${prefix}/legal/`)} class="footer__link">{t.legal}</a></li>
          <li><a href={withBase(`${prefix}/legal/#requisites`)} class="footer__link">{t.requisites}</a></li>
        </ul>
      </div>
    </nav>

    <div class="footer__bottom">
      <span>&copy; {new Date().getFullYear()} {t.rights}</span>
      <span>{isEn ? 'Aleksandro-Nevskaya Manufaktura' : 'Александро-Невская Мануфактура'}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface-dark);
    color: rgba(255, 255, 255, 0.85);
    padding-block: clamp(4rem, 8vw, 7rem) var(--space-xl);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-2xl);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .footer__lead {
    max-width: 30ch;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
    line-height: 1.35;
    color: #fff;
    white-space: pre-line;
  }

  .footer__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__phone {
    display: inline-block;
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-weight: var(--weight-thin);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
    transition: opacity var(--transition-fast);
  }

  .footer__phone:hover {
    color: #fff;
    opacity: 0.7;
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: var(--space-lg);
    font-size: var(--text-small);
  }

  .footer__meta-link {
    color: rgba(255, 255, 255, 0.85);
  }

  .footer__meta-link:hover {
    color: #fff;
  }

  .footer__address {
    color: rgba(255, 255, 255, 0.5);
  }

  /* Oversized grey brand mark — echoes the brand layout */
  .footer__mark {
    display: block;
    width: clamp(7rem, 16vw, 13rem);
    aspect-ratio: 1;
    background-color: #5a5a5a;
    -webkit-mask: var(--logo-mask) center / contain no-repeat;
    mask: var(--logo-mask) center / contain no-repeat;
    transition: background-color var(--transition-slow);
  }

  .footer__mark:hover {
    background-color: var(--color-cta);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer__heading {
    margin-bottom: var(--space-md);
    font-size: var(--text-caption);
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__link {
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.85);
  }

  .footer__link:hover {
    color: #fff;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--text-micro);
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 767px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__mark {
      width: 5rem;
      order: -1;
    }

    .footer__nav {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

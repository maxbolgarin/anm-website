---
import { withBase } from '@utils/withBase';
import { getLocaleFromPath } from '@utils/locale';

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isEn = locale === 'en';

const keywordsRu = [
  { label: 'Офисы у м. Елизаровская', href: '/buildings/' },
  { label: 'Офисы в Невском районе', href: '/buildings/' },
  { label: 'Лофт-офисы СПб', href: '/buildings/fidel/' },
  { label: 'Офисы 50–100 м²', href: '/buildings/' },
  { label: 'Офисы 100–300 м²', href: '/buildings/' },
  { label: 'Офисы 300+ м²', href: '/buildings/' },
  { label: 'Аренда офисов класса B+', href: '/buildings/' },
  { label: 'Офисы с паркингом', href: '/buildings/' },
];

const keywordsEn = [
  { label: 'Offices near Elizarovskaya metro', href: '/en/buildings/' },
  { label: 'Offices in Nevsky district', href: '/en/buildings/' },
  { label: 'Loft offices SPb', href: '/en/buildings/fidel/' },
  { label: 'Offices 50–100 m²', href: '/en/buildings/' },
  { label: 'Offices 100–300 m²', href: '/en/buildings/' },
  { label: 'Offices 300+ m²', href: '/en/buildings/' },
  { label: 'Class B+ office rental', href: '/en/buildings/' },
  { label: 'Offices with parking', href: '/en/buildings/' },
];

const keywords = isEn ? keywordsEn : keywordsRu;
const label = isEn ? 'Popular searches' : 'Часто ищут';
---

<nav class="seo-keywords" aria-label={label}>
  <div class="container seo-keywords__inner">
    <span class="seo-keywords__label">{label}</span>
    <ul class="seo-keywords__list">
      {keywords.map((kw) => (
        <li><a href={withBase(kw.href)} class="seo-keywords__link">{kw.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .seo-keywords {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-line);
  }

  .seo-keywords__inner {
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
  }

  .seo-keywords__label {
    flex-shrink: 0;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .seo-keywords__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .seo-keywords__link {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .seo-keywords__link:hover {
    color: var(--color-ink);
  }

  @media (max-width: 767px) {
    .seo-keywords__inner {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

---
import Img from '@components/Img.astro';

interface Props {
  name: string;
  description: string;
  image: string;
  imageAlt: string;
}

const { name, description, image, imageAlt } = Astro.props;
---

<div class="facility-card">
  <div class="facility-card__image-wrap">
    <Img src={image} alt={imageAlt} class="facility-card__image" sizes="(min-width: 1024px) 33vw, 100vw" />
  </div>
  <div class="facility-card__content">
    <h3 class="facility-card__name">{name}</h3>
    <p class="facility-card__desc">{description}</p>
  </div>
</div>

<style>
  .facility-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .facility-card__image-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-warm);
  }

  .facility-card__image-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .facility-card:hover .facility-card__image-wrap :global(img) {
    transform: scale(1.04);
  }

  .facility-card__content {
    padding-top: 1rem;
    border-top: 1px solid var(--color-line-strong);
  }

  .facility-card__name {
    margin-bottom: 0.5rem;
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
    letter-spacing: -0.02em;
  }

  .facility-card__desc {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
</style>

---
import { withBase } from '@utils/withBase';

interface Props {
  name: string;
  description: string;
  image: string;
  imageAlt: string;
}

const { name, description, image, imageAlt } = Astro.props;
---

<div class="facility-card">
  <div class="facility-card__image-wrap">
    <img src={withBase(image)} alt={imageAlt} class="facility-card__image" loading="lazy" />
  </div>
  <div class="facility-card__content">
    <h3 class="facility-card__name">{name}</h3>
    <p class="facility-card__desc">{description}</p>
  </div>
</div>

<style>
  .facility-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-text-primary);
    border-bottom: 3px solid var(--color-primary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: box-shadow var(--transition-base);
    isolation: isolate;
  }

  .facility-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.14);
  }

  .facility-card__image-wrap {
    position: relative;
    overflow: hidden;
  }

  .facility-card__image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.45) 25%,
      rgba(0, 0, 0, 0.10) 50%,
      transparent 65%
    );
    pointer-events: none;
    z-index: 1;
  }

  .facility-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .facility-card:hover .facility-card__image {
    transform: scale(1.03);
  }

  .facility-card__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: var(--space-md) var(--space-lg) var(--space-sm);
    color: var(--color-text-inverse);
  }

  .facility-card__name {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-xs);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .facility-card__desc {
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.90);
    line-height: var(--leading-relaxed);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }
</style>

---
import { contactInfo } from '@data/navigation';
import { buildings } from '@data/buildings';
import { getLocaleFromPath } from '@utils/locale';
import { getBuildingEnBySlug } from '@data/buildings-en';

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isEn = locale === 'en';

const routeLinks = buildings.map((b) => {
  const en = getBuildingEnBySlug(b.slug);
  return {
    name: isEn ? (en?.fullName ?? b.name) : (b.slug === 'fidel' ? 'Бизнес-лофт Фидель' : 'Бизнес-центр АНМ'),
    twogis: `https://2gis.ru/spb/directions/points/~${b.coordinates.lng},${b.coordinates.lat}`,
    yandex: `https://yandex.ru/maps/?rtext=~${b.coordinates.lat},${b.coordinates.lng}&rtt=auto`,
  };
});

const t = isEn
  ? {
      eyebrow: 'Contacts',
      title: 'We are always in touch',
      getHere: 'How to get here',
      metro: 'Elizarovskaya',
      walk: '9 min walk',
      address: 'Saint Petersburg, Obukhovskoy Oborony Ave. 70, bldg. 2, lit. A',
      directions: 'The territory lies on the Neva embankment, a 9-minute walk from Elizarovskaya metro station (green line), with convenient car access from Obukhovskoy Oborony Avenue.',
      rows: [
        { label: 'Leasing department', value: contactInfo.commercial, href: contactInfo.commercialHref },
        { label: 'Main line', value: contactInfo.phone, href: contactInfo.phoneHref },
        { label: 'Reception', value: contactInfo.reception, href: contactInfo.receptionHref },
        { label: 'Email', value: contactInfo.email, href: contactInfo.emailHref },
      ],
      yandex: 'Yandex Maps',
    }
  : {
      eyebrow: 'Контакты',
      title: 'Мы всегда на связи',
      getHere: 'Как добраться',
      metro: 'Елизаровская',
      walk: '9 минут пешком',
      address: contactInfo.address,
      directions: 'Территория расположена на набережной Невы, в 9 минутах ходьбы от станции метро «Елизаровская» (зелёная линия). Удобный подъезд на автомобиле с проспекта Обуховской Обороны.',
      rows: [
        { label: 'Коммерческий отдел', value: contactInfo.commercial, href: contactInfo.commercialHref },
        { label: 'Основной телефон', value: contactInfo.phone, href: contactInfo.phoneHref },
        { label: 'Приёмная', value: contactInfo.reception, href: contactInfo.receptionHref },
        { label: 'Email', value: contactInfo.email, href: contactInfo.emailHref },
      ],
      yandex: 'Яндекс Карты',
    };
---

<section class="loc section" aria-labelledby="loc-title">
  <div class="container">
    <div class="loc__grid">
      <div class="loc__head" data-reveal>
        <span class="eyebrow">{t.eyebrow}</span>
        <h2 class="loc__title" id="loc-title">{t.title}</h2>
      </div>

      <dl class="loc__rows" data-reveal>
        {t.rows.map((r) => (
          <div class="loc__row">
            <dt>{r.label}</dt>
            <dd><a href={r.href}>{r.value}</a></dd>
          </div>
        ))}
      </dl>

      <div class="loc__where" data-reveal style="--reveal-delay: 100ms">
        <h3 class="loc__subtitle">{t.getHere}</h3>
        <p class="loc__metro">
          <span class="loc__metro-dot" aria-hidden="true"></span>
          <span>{isEn ? 'Metro' : 'м.'} {t.metro}</span>
          <span class="loc__metro-time">{t.walk}</span>
        </p>
        <p class="loc__address">{t.address}</p>
        <p class="loc__directions">{t.directions}</p>

        <ul class="loc__routes">
          {routeLinks.map((r) => (
            <li class="loc__route">
              <span class="loc__route-name">{r.name}</span>
              <span class="loc__route-links">
                <a href={r.yandex} target="_blank" rel="noopener noreferrer">{t.yandex}</a>
                <a href={r.twogis} target="_blank" rel="noopener noreferrer">2GIS</a>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .loc__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-2xl);
  }

  .loc__head {
    grid-column: 1 / 13;
  }

  .loc__head .eyebrow {
    margin-bottom: 1rem;
  }

  .loc__title {
    font-size: var(--text-h2);
  }

  .loc__rows {
    grid-column: 1 / 7;
    border-top: 1px solid var(--color-line-strong);
  }

  .loc__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .loc__row dt {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .loc__row dd a {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .loc__row dd a:hover {
    color: var(--color-cta);
  }

  .loc__where {
    grid-column: 8 / 13;
  }

  .loc__subtitle {
    margin-bottom: 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }

  .loc__metro {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
    font-size: 1.0625rem;
  }

  .loc__metro-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #009A49;
  }

  .loc__metro-time {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .loc__address {
    margin-bottom: 0.75rem;
    font-size: var(--text-small);
  }

  .loc__directions {
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .loc__routes {
    margin-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .loc__route {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }

  .loc__route-name {
    font-size: var(--text-small);
  }

  .loc__route-links {
    display: flex;
    gap: 1.25rem;
  }

  .loc__route-links a {
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 2px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .loc__route-links a:hover {
    color: var(--color-cta);
    border-color: var(--color-cta);
  }

  @media (max-width: 1023px) {
    .loc__rows,
    .loc__where {
      grid-column: 1 / 13;
    }
  }
</style>

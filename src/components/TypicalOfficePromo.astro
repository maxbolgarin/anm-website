---
import { withBase } from '@utils/withBase';
import { getLocaleFromPath } from '@utils/locale';

interface Props {
  buildingName: string;
  buildingLabel: string;
  planImage: string;
  area: string;
  buildingClass: string;
  type: string;
  pricePerSqm: string;
  href: string;
}

const { buildingName, buildingLabel, planImage, area, buildingClass, type, pricePerSqm, href } = Astro.props;
const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isEn = locale === 'en';
---

<section class="typical-promo section">
  <div class="container">
    <div class="typical-promo__card">
      <div class="typical-promo__content">
        <h3 class="typical-promo__title">{isEn ? `Example office layout in ${buildingLabel}` : `Пример планировки офиса в ${buildingLabel}`}</h3>
        <div class="typical-promo__params">
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Area' : 'Площадь'}</span>
            <span class="typical-promo__param-value">{area}</span>
          </div>
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Class' : 'Класс'}</span>
            <span class="typical-promo__param-value">{buildingClass}</span>
          </div>
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Type' : 'Тип'}</span>
            <span class="typical-promo__param-value">{type}</span>
          </div>
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Price' : 'Стоимость'}</span>
            <span class="typical-promo__param-value">{pricePerSqm}</span>
          </div>
        </div>
        <a href={withBase(href)} class="btn btn--primary typical-promo__btn">{isEn ? 'View Available Offices' : 'Смотреть свободные офисы'}</a>
      </div>
      <div class="typical-promo__image-wrap">
        <img src={withBase(planImage)} alt={`${isEn ? 'Typical office plan' : 'Планировка типового офиса'} — ${buildingName}`} class="typical-promo__image" />
      </div>
    </div>
  </div>
</section>

<style>
  .typical-promo {
    /* inherits full padding-block from .section */
  }

  .typical-promo__card {
    display: grid;
    grid-template-columns: 2fr 3fr;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .typical-promo__image-wrap {
    background-color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
    min-height: 20rem;
  }

  .typical-promo__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    max-height: 22rem;
  }

  .typical-promo__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem 3rem;
    gap: 1.5rem;
    background-color: var(--color-surface-cream);
    border-right: 1px solid var(--color-border);
    border-top: 3px solid var(--color-burgundy);
  }

  .typical-promo__title {
    font-size: var(--text-heading);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .typical-promo__params {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 2rem;
  }

  .typical-promo__param {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .typical-promo__param-label {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }

  .typical-promo__param-value {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .typical-promo__btn {
    align-self: flex-start;
  }

  @media (max-width: 1023px) {
    .typical-promo__card {
      grid-template-columns: 1fr 1fr;
    }

    .typical-promo__content {
      padding: 2rem 2rem;
    }
  }

  @media (max-width: 767px) {
    .typical-promo__card {
      grid-template-columns: 1fr;
    }

    .typical-promo__image-wrap {
      padding: 1.5rem;
      min-height: auto;
    }

    .typical-promo__image {
      max-height: 14rem;
    }

    .typical-promo__content {
      padding: 1.75rem 1.5rem;
      border-right: none;
      border-top: 3px solid var(--color-burgundy);
    }

    .typical-promo__title {
      font-size: clamp(1.125rem, 3vw + 0.5rem, 1.5rem);
    }
  }
</style>

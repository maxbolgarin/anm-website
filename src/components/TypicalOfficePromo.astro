---
import { withBase } from '@utils/withBase';
import { getLocaleFromPath } from '@utils/locale';

interface Props {
  buildingName: string;
  buildingLabel: string;
  planImage: string;
  area: string;
  buildingClass: string;
  type: string;
  pricePerSqm: string;
  href: string;
}

const { buildingName, buildingLabel, planImage, area, buildingClass, type, pricePerSqm, href } = Astro.props;
const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isEn = locale === 'en';
---

<section class="typical-promo section">
  <div class="container">
    <div class="typical-promo__card">
      <div class="typical-promo__content">
        <h3 class="typical-promo__title">{isEn ? `Example office layout in ${buildingLabel}` : `Пример планировки офиса в ${buildingLabel}`}</h3>
        <div class="typical-promo__params">
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Area' : 'Площадь'}</span>
            <span class="typical-promo__param-value">{area}</span>
          </div>
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Class' : 'Класс'}</span>
            <span class="typical-promo__param-value">{buildingClass}</span>
          </div>
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Type' : 'Тип'}</span>
            <span class="typical-promo__param-value">{type}</span>
          </div>
          <div class="typical-promo__param">
            <span class="typical-promo__param-label">{isEn ? 'Price' : 'Стоимость'}</span>
            <span class="typical-promo__param-value">{pricePerSqm}</span>
          </div>
        </div>
        <a href={withBase(href)} class="btn btn--primary btn--wide typical-promo__btn">{isEn ? 'View Available Offices' : 'Смотреть свободные офисы'}</a>
      </div>
      <div class="typical-promo__image-wrap">
        <img src={withBase(planImage)} alt={`${isEn ? 'Typical office plan' : 'Планировка типового офиса'} — ${buildingName}`} class="typical-promo__image" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  .typical-promo__card {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .typical-promo__content {
    grid-column: 1 / 6;
  }

  .typical-promo__title {
    margin-bottom: var(--space-xl);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.025em;
  }

  .typical-promo__params {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .typical-promo__param {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .typical-promo__param-label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .typical-promo__param-value {
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  .typical-promo__image-wrap {
    grid-column: 7 / 13;
  }

  .typical-promo__image {
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .typical-promo__content,
    .typical-promo__image-wrap {
      grid-column: 1 / 13;
    }
  }
</style>

---
interface StatItem {
  value: string | number;
  label: string;
  unit?: string;
}

interface Props {
  stats: StatItem[];
  columns?: number;
}

const { stats, columns } = Astro.props;
---

<div class="stats-row" data-columns={columns}>
  {stats.map((stat) => (
    <div class="stats-row__item">
      <span class="stats-row__value">
        {stat.value}
        {stat.unit && <span class="stats-row__unit">{stat.unit}</span>}
      </span>
      <span class="stats-row__label">{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-lg);
    margin-block: var(--space-xl);
  }

  .stats-row[data-columns="2"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats-row__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .stats-row__value {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stats-row__unit {
    margin-left: 0.25rem;
    font-size: 0.5em;
    color: var(--color-text-muted);
  }

  .stats-row__label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
</style>

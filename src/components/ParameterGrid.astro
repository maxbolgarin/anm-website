---
import { getLocaleFromPath } from '@utils/locale';

interface Parameter {
  label: string;
  value: string;
}

interface Props {
  parameters: Parameter[];
  title?: string;
}

const { parameters, title: titleProp } = Astro.props;
const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const isEn = locale === 'en';
const title = titleProp || (isEn ? 'Key Parameters' : 'Основные параметры');
---

<section class="param-grid section--cream">
  <div class="container">
    <h2 class="param-grid__title">{title}</h2>
    <div class="param-grid__grid">
      {parameters.map((param) => (
        <div class="param-grid__item">
          <span class="param-grid__label">{param.label}</span>
          <span class="param-grid__value">{param.value}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .param-grid {
    padding-block: var(--section-space);
    background: var(--color-surface-warm);
  }

  .param-grid__title {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: var(--text-h2);
  }

  .param-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
    border-top: 1px solid var(--color-line-strong);
  }

  .param-grid__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .param-grid__label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .param-grid__value {
    font-size: var(--text-small);
    text-align: right;
    color: var(--color-ink);
  }

  @media (max-width: 767px) {
    .param-grid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

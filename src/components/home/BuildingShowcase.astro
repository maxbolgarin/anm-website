---
/**
 * Editorial building showcase for the home page.
 * Typographic switch → hero photo with overlapping card → staggered collage
 * with captions → "space" block with a lightweight photo carousel → CTA.
 */
import Img from '@components/Img.astro';
import media from '@data/media-v2.json';
import { getShowcase, type BuildingShowcase } from '@data/showcase';
import { withBase } from '@utils/withBase';
import type { Locale } from '@utils/locale';

interface Props {
  locale: Locale;
  building: BuildingShowcase;
  first?: boolean;
}

const { locale, building: b, first = false } = Astro.props;
const all = getShowcase(locale);
const isEn = locale === 'en';
const prefix = isEn ? '/en' : '';
const m = media as Record<string, { w: number; h: number; smW: number }>;
const v2 = (name: string, sm = false) => withBase(`/images/v2/${name}${sm ? '-sm' : ''}.jpg`);
const srcset = (name: string) => `${v2(name, true)} ${m[name].smW}w, ${v2(name)} ${m[name].w}w`;

const t = isEn
  ? { ours: 'Our buildings:', rent: 'Lease a space', more: b.slug === 'fidel' ? 'About the business loft' : 'About the business center', prev: 'Previous photo', next: 'Next photo', photo: 'Photo' }
  : { ours: 'Наши объекты:', rent: 'Арендовать помещение', more: b.slug === 'fidel' ? 'О бизнес-лофте' : 'О бизнес-центре', prev: 'Предыдущее фото', next: 'Следующее фото', photo: 'Фото' };

const heroRatio = b.slug === 'anm' ? '2.35 / 1' : '16 / 9';
const total = b.gallery.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class:list={['showcase', `showcase--${b.slug}`, { 'showcase--first': first }]} id={b.slug} aria-labelledby={`showcase-${b.slug}`}>
  <div class="container">
    <header class="showcase__switch" data-reveal>
      <span class="eyebrow">{t.ours}</span>
      <div class="showcase__names">
        {all.map((item, i) => (
          <>
            {i > 0 && <span class="showcase__slash" aria-hidden="true">/</span>}
            {item.slug === b.slug ? (
              <h2 class="showcase__name is-active" id={`showcase-${b.slug}`}>{item.title}</h2>
            ) : (
              <a href={`#${item.slug}`} class="showcase__name">{item.title}</a>
            )}
          </>
        ))}
      </div>
    </header>
  </div>

  <!-- Lead: hero photograph + overlapping card + key figures -->
  <div class="showcase__lead container-wide">
    <figure class="showcase__hero" style={`--ratio: ${heroRatio}`} data-reveal>
      <Img name={b.hero.name} alt={b.hero.alt} sizes="(min-width: 1024px) 80vw, 100vw" />
    </figure>

    <div class="showcase__card" data-reveal style="--reveal-delay: 120ms">
      <h3 class="showcase__headline">{b.headline}</h3>
      <ul class="showcase__features">
        {b.features.map((f) => (
          <li class="showcase__feature">
            <h4 class="showcase__feature-title">{f.title}</h4>
            <p class="showcase__feature-text">{f.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <dl class="showcase__stats" data-reveal>
      {b.stats.map((s) => (
        <div class="showcase__stat">
          <dt class="showcase__stat-label">{s.label}</dt>
          <dd class="showcase__stat-value">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <!-- Collage -->
  <div class="container">
    <div class="showcase__collage">
      {b.collage.map((img, i) => (
        <figure class={`showcase__tile showcase__tile--${i + 1} figure`} data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <div class="showcase__tile-media zoom" style={img.focus ? `--focus: ${img.focus}` : undefined}>
            <Img name={img.name} alt={img.alt} sizes="(min-width: 1024px) 40vw, 50vw" />
          </div>
          <figcaption class="figure__caption">{img.caption}</figcaption>
        </figure>
      ))}
    </div>

    <!-- Space: text + carousel -->
    <div class="showcase__space">
      <div class="showcase__space-text" data-reveal>
        <h3 class="showcase__space-title">{b.spaceTitle}</h3>
        <div class="showcase__space-cols">
          <p>{b.spaceText[0]}</p>
          <p>{b.spaceText[1]}</p>
        </div>
      </div>

      <div class="gallery" data-gallery data-reveal aria-roledescription="carousel" aria-label={b.title}>
        <div class="gallery__stage">
          {b.gallery.map((img, i) => (
            <figure class:list={['gallery__slide', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'} data-index={i}>
              {i === 0 ? (
                <img src={v2(img.name)} srcset={srcset(img.name)} sizes="(min-width: 1024px) 55vw, 100vw" width={m[img.name].w} height={m[img.name].h} alt={img.alt} loading="lazy" decoding="async" />
              ) : (
                <img data-src={v2(img.name)} data-srcset={srcset(img.name)} sizes="(min-width: 1024px) 55vw, 100vw" width={m[img.name].w} height={m[img.name].h} alt={img.alt} decoding="async" />
              )}
              <figcaption class="gallery__caption">{img.caption}</figcaption>
            </figure>
          ))}
        </div>

        <div class="gallery__thumbs" role="group" aria-label={isEn ? 'Up next' : 'Далее'}>
          {b.gallery.map((img, i) => (
            <button type="button" class="gallery__thumb" data-go={i} aria-label={`${t.photo} ${i + 1}: ${img.caption}`} hidden={i < 1 || i > 3}>
              <img src={v2(img.name, true)} alt="" width={m[img.name].smW} height={Math.round(m[img.name].h * m[img.name].smW / m[img.name].w)} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>

        <div class="gallery__controls">
          <button type="button" class="gallery__arrow gallery__arrow--prev" data-prev aria-label={t.prev}></button>
          <button type="button" class="gallery__arrow gallery__arrow--next" data-next aria-label={t.next}></button>
          <span class="gallery__count" aria-live="polite"><span data-current>{pad(1)}</span> / {pad(total)}</span>
        </div>
      </div>
    </div>

    <div class="showcase__cta" data-reveal>
      <a href={withBase(`${prefix}/buildings/${b.slug}/`)} class="link-arrow">{t.more}</a>
      <a href={withBase(`${prefix}/arenda/`)} class="btn btn--primary btn--wide">{t.rent}</a>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section-space) 0;
    scroll-margin-top: var(--header-height);
  }

  .showcase + :global(.showcase) {
    padding-top: calc(var(--section-space) * 1.1);
  }

  /* ── Typographic switch ── */
  .showcase__switch {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .showcase__switch .eyebrow {
    margin-bottom: 0.75rem;
    font-size: clamp(1rem, 1.3vw, 1.375rem);
    font-weight: var(--weight-light);
  }

  .showcase__names {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .showcase__name {
    font-size: clamp(1.875rem, 3.6vw, 3.5rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #b9b5ae;
    transition: color var(--transition-base);
  }

  a.showcase__name:hover {
    color: var(--color-ink);
  }

  .showcase__name.is-active {
    color: var(--color-ink);
  }

  .showcase__slash {
    font-size: clamp(1.875rem, 3.6vw, 3.5rem);
    font-weight: var(--weight-thin);
    color: #b9b5ae;
  }

  /* ── Lead ── */
  .showcase__lead {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: var(--grid-gap);
  }

  .showcase__hero {
    grid-column: 1 / 11;
    grid-row: 1;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .showcase__hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase__card {
    grid-column: 7 / 13;
    grid-row: 1 / 3;
    align-self: end;
    position: relative;
    z-index: 2;
    padding: clamp(2rem, 3.4vw, 3.5rem);
    background: #fff;
    box-shadow: 0 30px 80px -40px rgba(20, 20, 20, 0.25);
  }

  .showcase__headline {
    max-width: 22ch;
    margin-bottom: clamp(1.5rem, 2.6vw, 2.5rem);
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .showcase__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .showcase__feature-title {
    margin-bottom: 0.6rem;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    line-height: 1.35;
  }

  .showcase__feature-text {
    margin: 0;
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .showcase__stats {
    grid-column: 1 / 7;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    align-self: start;
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .showcase__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .showcase__stat-value {
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .showcase__stat-label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  /* ── Collage — staggered, overlapping, captioned ── */
  .showcase__collage {
    --u: clamp(1.4rem, 2.9vw, 2.9rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: var(--u);
    column-gap: var(--grid-gap);
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .showcase__tile {
    position: relative;
  }

  .showcase__tile-media {
    height: 100%;
  }

  .showcase__tile-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
  }

  .showcase__tile .figure__caption {
    position: absolute;
    top: 100%;
    left: 0;
  }

  /* Tile 2 sits under tile 1 on its left edge — caption goes right */
  .showcase__tile--2 .figure__caption {
    left: auto;
    right: 0;
  }

  .showcase__tile--1 { grid-column: 1 / 6;  grid-row: 3 / 11; z-index: 2; }
  .showcase__tile--2 { grid-column: 5 / 13; grid-row: 1 / 9; }
  .showcase__tile--3 { grid-column: 7 / 12; grid-row: 10 / 17; z-index: 2; }
  .showcase__tile--4 { grid-column: 2 / 6;  grid-row: 12 / 20; }

  /* White keyline where tiles overlap */
  .showcase__tile--1 .showcase__tile-media,
  .showcase__tile--3 .showcase__tile-media {
    outline: clamp(6px, 0.7vw, 10px) solid #fff;
  }

  /* ── Space block ── */
  .showcase__space {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-2xl);
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  /* Text and carousel share row 1: text sits over the carousel's empty left column */
  .showcase__space-text {
    position: relative;
    z-index: 1;
    grid-column: 1 / 6;
    grid-row: 1;
    align-self: start;
  }

  .showcase__space-title {
    max-width: 16ch;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(1.75rem, 2.6vw, 2.625rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.028em;
    line-height: 1.12;
  }

  .showcase__space-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .showcase__space-cols p {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* ── Gallery / carousel ── */
  .gallery {
    grid-column: 1 / 13;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto auto;
    column-gap: var(--grid-gap);
    row-gap: var(--space-md);
  }

  .gallery__stage {
    position: relative;
    grid-column: 6 / 13;
    grid-row: 1 / 3;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-warm);
    touch-action: pan-y;
  }

  .gallery__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }

  .gallery__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .gallery__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 6s var(--ease-out);
  }

  .gallery__slide.is-active img {
    transform: none;
  }

  .gallery__caption {
    position: absolute;
    left: 1rem;
    bottom: 0.85rem;
    padding: 0.25rem 0.55rem;
    font-size: var(--text-micro);
    letter-spacing: 0.02em;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.9);
  }

  .gallery__thumbs {
    grid-column: 1 / 6;
    grid-row: 2;
    align-self: end;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .gallery__thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-warm);
  }

  .gallery__thumb[hidden] {
    display: none;
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out), opacity var(--transition-base);
  }

  .gallery__thumb:hover img {
    transform: scale(1.05);
    opacity: 0.85;
  }

  .gallery__controls {
    grid-column: 6 / 13;
    grid-row: 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery__arrow {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .gallery__arrow::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
  }

  .gallery__arrow--prev::before { transform: translate(-30%, -50%) rotate(-135deg); }
  .gallery__arrow--next::before { transform: translate(-70%, -50%) rotate(45deg); }

  .gallery__arrow:hover {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }

  .gallery__count {
    margin-left: auto;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .gallery__count [data-current] {
    color: var(--color-ink);
  }

  /* ── CTA row ── */
  .showcase__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-lg) var(--space-2xl);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: var(--space-md);
  }

  /* ── Tablet / mobile ── */
  @media (max-width: 1023px) {
    .showcase__hero {
      grid-column: 1 / 13;
    }

    .showcase__card {
      grid-column: 2 / 13;
      grid-row: 2;
      margin-top: calc(-1 * clamp(3rem, 12vw, 6rem));
    }

    .showcase__stats {
      grid-column: 1 / 13;
      grid-row: 3;
    }

    .showcase__space-text {
      grid-column: 1 / 13;
      grid-row: 1;
    }

    .gallery {
      grid-row: 2;
    }

    .gallery__stage {
      grid-column: 1 / 13;
      grid-row: 1;
    }

    .gallery__thumbs {
      grid-column: 1 / 13;
      grid-row: 2;
    }

    .gallery__controls {
      grid-column: 1 / 13;
      grid-row: 3;
    }
  }

  @media (max-width: 767px) {
    .showcase__card {
      grid-column: 1 / 13;
      margin-inline: 0.75rem;
      padding: 1.75rem 1.5rem;
    }

    .showcase__features {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .showcase__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .showcase__collage {
      --u: 1.25rem;
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .showcase__tile--1 { grid-column: 1 / 5; grid-row: 6 / 14; }
    .showcase__tile--2 { grid-column: 2 / 7; grid-row: 1 / 8; }
    .showcase__tile--3 { grid-column: 3 / 7; grid-row: 15 / 22; }
    .showcase__tile--4 { grid-column: 1 / 4; grid-row: 19 / 27; z-index: 3; }

    .showcase__space-cols {
      grid-template-columns: 1fr;
    }

    .gallery__thumbs {
      display: none;
    }

    .showcase__cta {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .showcase__cta .link-arrow {
      align-self: flex-start;
    }
  }
</style>

<script>
  // Lightweight carousel: crossfade, "up next" thumbnails, arrows, keys, swipe.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.gallery__slide'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const current = root.querySelector<HTMLElement>('[data-current]');
    const stage = root.querySelector<HTMLElement>('.gallery__stage');
    const n = slides.length;
    let index = 0;

    const hydrate = (i: number) => {
      const img = slides[(i + n) % n]?.querySelector<HTMLImageElement>('img[data-src]');
      if (!img) return;
      img.srcset = img.dataset.srcset || '';
      img.src = img.dataset.src || '';
      img.removeAttribute('data-src');
      img.removeAttribute('data-srcset');
    };

    const go = (i: number) => {
      index = (i + n) % n;
      hydrate(index);
      hydrate(index + 1);
      slides.forEach((s, k) => {
        const on = k === index;
        s.classList.toggle('is-active', on);
        if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
      });
      // Show the next three photos as "up next" thumbnails, in order
      thumbs.forEach((t) => (t.hidden = true));
      for (let k = 1; k <= 3; k++) {
        const t = thumbs[(index + k) % n];
        if (t) { t.hidden = false; t.style.order = String(k); }
      }
      if (current) current.textContent = String(index + 1).padStart(2, '0');
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.go))));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });

    // Swipe
    let x0: number | null = null;
    stage?.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    stage?.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    // Warm up the second slide once the carousel is near the viewport
    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { hydrate(1); o.disconnect(); }
    }, { rootMargin: '400px' }).observe(root);
  });
</script>

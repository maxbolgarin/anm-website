---
/**
 * Company teaser — aerial photograph with an overlapping white card.
 * Speaks to tenants (track record) and investors (redevelopment vision).
 */
import Img from '@components/Img.astro';
import { withBase } from '@utils/withBase';
import type { Locale } from '@utils/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const prefix = isEn ? '/en' : '';

const t = isEn
  ? {
      eyebrow: 'The company',
      title: 'For over 20 years we have been creating a comfortable environment for business',
      text: 'ANM is a development and management company transforming a former industrial site on Obukhovskoy Oborony Avenue into a modern business quarter. The redevelopment concept was created by the British architectural practice Horan Keoghan Ryan: historic buildings keep their character and gain contemporary engineering and comfort.',
      stats: [
        { value: '20+', label: 'years on the market' },
        { value: '21,376', label: 'm² under management' },
        { value: '80+', label: 'tenant companies' },
      ],
      link: 'Company & history',
      caption: 'the territory from above',
      alt: 'Aerial view of the Aleksandro-Nevskaya Manufaktura territory on the Neva',
    }
  : {
      eyebrow: 'О компании',
      title: 'Более 20 лет создаём комфортную среду для бизнеса',
      text: 'АНМ — девелоперская и управляющая компания, которая превращает бывшую промышленную территорию на проспекте Обуховской Обороны в современный деловой квартал. Концепция редевелопмента разработана британским бюро Horan Keoghan Ryan: исторические здания сохраняют характер и получают современную инженерию и комфорт.',
      stats: [
        { value: '20+', label: 'лет на рынке' },
        { value: '21 376', label: 'м² под управлением' },
        { value: '80+', label: 'компаний-арендаторов' },
      ],
      link: 'Компания и история',
      caption: 'территория с высоты',
      alt: 'Территория Александро-Невской Мануфактуры на Неве с высоты',
    };
---

<section class="teaser" aria-labelledby="teaser-title">
  <div class="teaser__inner container-wide">
    <figure class="teaser__media figure" data-reveal>
      <Img name="territory-aerial-2" alt={t.alt} sizes="(min-width: 1024px) 75vw, 100vw" />
      <figcaption class="figure__caption">{t.caption}</figcaption>
    </figure>

    <div class="teaser__card" data-reveal style="--reveal-delay: 120ms">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="teaser__title" id="teaser-title">{t.title}</h2>
      <p class="teaser__text">{t.text}</p>
      <dl class="teaser__stats">
        {t.stats.map((s) => (
          <div class="teaser__stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <a href={withBase(`${prefix}/about/company/`)} class="link-arrow">{t.link}</a>
    </div>
  </div>
</section>

<style>
  .teaser {
    padding-block: var(--section-space);
  }

  .teaser__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    align-items: center;
  }

  .teaser__media {
    grid-column: 4 / 13;
    grid-row: 1;
    aspect-ratio: 16 / 10;
  }

  .teaser__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .teaser__media .figure__caption {
    text-align: right;
  }

  .teaser__card {
    grid-column: 1 / 7;
    grid-row: 1;
    position: relative;
    z-index: 2;
    margin-top: clamp(-6rem, -8vw, -2rem);
    align-self: start;
    padding: clamp(2rem, 3.6vw, 3.75rem);
    background: #fff;
    box-shadow: 0 30px 80px -40px rgba(20, 20, 20, 0.25);
  }

  .teaser__card .eyebrow {
    margin-bottom: 1rem;
  }

  .teaser__title {
    max-width: 18ch;
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 2.6vw, 2.75rem);
  }

  .teaser__text {
    max-width: 34rem;
    font-size: var(--text-small);
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .teaser__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0 var(--space-xl);
  }

  .teaser__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
  }

  .teaser__stat dd {
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .teaser__stat dt {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .teaser__media {
      grid-column: 1 / 13;
    }

    .teaser__card {
      grid-column: 1 / 13;
      grid-row: 2;
      margin: calc(-1 * clamp(3rem, 10vw, 6rem)) 0.75rem 0;
    }
  }

  @media (max-width: 560px) {
    .teaser__stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

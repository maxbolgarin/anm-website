---
/**
 * "Everything on site" — an editorial index instead of cards.
 * Desktop: numbered list on the left, a sticky photograph on the right that
 * cross-fades to whichever amenity is hovered / focused.
 * Mobile: each row carries its own photograph.
 */
import Img from '@components/Img.astro';
import type { Locale } from '@utils/locale';

interface Props {
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { locale, headingLevel = 'h2' } = Astro.props;
const isEn = locale === 'en';
const H = headingLevel;

const t = isEn
  ? {
      eyebrow: 'Infrastructure',
      title: 'Everything you need, right on site',
      lead: 'Your team never has to leave the territory: food, sport, parking and fresh air by the river — all within a few steps.',
      alsoTitle: 'Also included',
    }
  : {
      eyebrow: 'Инфраструктура',
      title: 'Всё необходимое — на территории',
      lead: 'Сотрудникам не нужно выходить за территорию: питание, спорт, парковка и прогулки у Невы — всё в шаговой доступности.',
      alsoTitle: 'А также',
    };

const items = isEn
  ? [
      { name: 'Secured parking', text: '328 spaces across the territory, guest parking and monthly passes.', image: 'territory-parking', alt: 'Secured parking on the territory by the Neva' },
      { name: 'Cafés & canteens', text: 'Two canteens with set lunches and two cafés with fresh coffee and light bites.', image: 'anm-cafe-counter', alt: 'Café at Aleksandro-Nevskaya Manufaktura' },
      { name: 'Fitness studio', text: 'A modern studio on site with special rates for tenants.', image: 'fidel-fitness', alt: 'Fitness studio on the territory' },
      { name: 'Neva embankment', text: 'A promenade by the water for breaks, walks and meetings outdoors.', image: 'territory-neva', alt: 'View of the Neva from the territory' },
      { name: 'Meeting rooms', text: 'Modern meeting rooms with online booking for tenants.', image: 'fidel-meeting-2', alt: 'Meeting room with panoramic windows' },
      { name: 'Reception & security 24/7', text: 'Round-the-clock security, CCTV and electronic passes for staff and guests.', image: 'anm-reception', alt: 'Reception with turnstiles' },
    ]
  : [
      { name: 'Охраняемый паркинг', text: '328 машиномест на территории, гостевые места и абонементы.', image: 'territory-parking', alt: 'Охраняемый паркинг на территории у Невы' },
      { name: 'Кафе и столовые', text: 'Две столовые с комплексными обедами и два кафе со свежим кофе и лёгкими перекусами.', image: 'anm-cafe-counter', alt: 'Кафе на территории Александро-Невской Мануфактуры' },
      { name: 'Фитнес-студия', text: 'Современная студия на территории и специальные условия для арендаторов.', image: 'fidel-fitness', alt: 'Фитнес-студия на территории бизнес-центра' },
      { name: 'Набережная Невы', text: 'Прогулочная зона у воды — для перерывов, прогулок и встреч на свежем воздухе.', image: 'territory-neva', alt: 'Вид на Неву с территории' },
      { name: 'Переговорные', text: 'Современные переговорные комнаты с онлайн-бронированием для арендаторов.', image: 'fidel-meeting-2', alt: 'Переговорная с панорамными окнами' },
      { name: 'Ресепшн и охрана 24/7', text: 'Круглосуточная охрана, видеонаблюдение и электронные пропуска для сотрудников и гостей.', image: 'anm-reception', alt: 'Ресепшн с турникетами' },
    ];

const extras = isEn
  ? ['24/7 office access', 'Energy-efficient technologies', 'Choice of 6 telecom providers', 'Own gas boiler plant', 'Internal logistics', 'Modern security systems']
  : ['Круглосуточный доступ в офисы', 'Энергосберегающие технологии', '6 операторов связи на выбор', 'Собственная газовая котельная', 'Внутренняя логистика', 'Современные системы безопасности'];
---

<section class="amenities section section--warm" id="infrastructure">
  <div class="container">
    <div class="amenities__grid">
      <div class="amenities__intro" data-reveal>
        <span class="eyebrow">{t.eyebrow}</span>
        <H class="amenities__title">{t.title}</H>
        <p class="text-lead amenities__lead">{t.lead}</p>
      </div>

      <ol class="amenities__list" data-amenities>
        {items.map((it, i) => (
          <li class:list={['amenities__item', { 'is-active': i === 0 }]} data-index={i} tabindex="0" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="amenities__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="amenities__body">
              <h3 class="amenities__name">{it.name}</h3>
              <p class="amenities__text">{it.text}</p>
            </div>
            <div class="amenities__thumb" aria-hidden="true">
              <Img name={it.image} alt="" sizes="(max-width: 1023px) 8rem, 1px" />
            </div>
          </li>
        ))}
      </ol>

      <div class="amenities__visual" aria-hidden="true">
        <div class="amenities__frame">
          {items.map((it, i) => (
            <div class:list={['amenities__photo', { 'is-active': i === 0 }]} data-photo={i}>
              <Img name={it.image} alt={it.alt} sizes="(min-width: 1024px) 45vw, 1px" />
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="amenities__extras" data-reveal>
      <span class="amenities__extras-title">{t.alsoTitle}</span>
      <ul class="amenities__extras-list">
        {extras.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .amenities__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
  }

  .amenities__intro {
    grid-column: 1 / 7;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .amenities__intro .eyebrow {
    margin-bottom: 1rem;
  }

  .amenities__title {
    max-width: 14ch;
    margin-bottom: 1.25rem;
    font-size: var(--text-h2);
  }

  .amenities__lead {
    max-width: 34rem;
    margin: 0;
  }

  .amenities__list {
    grid-column: 1 / 7;
    grid-row: 2;
    border-top: 1px solid var(--color-line-strong);
  }

  .amenities__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-md);
    padding-block: clamp(1.1rem, 1.8vw, 1.6rem);
    border-bottom: 1px solid var(--color-line-strong);
    cursor: default;
    outline: none;
  }

  .amenities__num {
    padding-top: 0.55rem;
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-base);
  }

  .amenities__name {
    font-size: clamp(1.375rem, 2.1vw, 2.125rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: #7d7870;
    transition: color var(--transition-base), transform var(--transition-base);
  }

  .amenities__text {
    max-width: 30rem;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    font-size: var(--text-small);
    line-height: 1.65;
    color: var(--color-text-secondary);
    transition: max-height 600ms var(--ease-out), opacity 400ms var(--ease-out), margin 400ms var(--ease-out);
  }

  .amenities__item.is-active .amenities__name,
  .amenities__item:focus-visible .amenities__name {
    color: var(--color-ink);
  }

  .amenities__item.is-active .amenities__num {
    color: var(--color-cta);
  }

  .amenities__item.is-active .amenities__text {
    max-height: 8rem;
    opacity: 1;
    margin-top: 0.75rem;
  }

  .amenities__thumb {
    display: none;
  }

  /* Sticky photograph */
  .amenities__visual {
    grid-column: 8 / 13;
    grid-row: 1 / 3;
  }

  .amenities__frame {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9e5de;
  }

  .amenities__photo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.9s var(--ease-out), transform 1.6s var(--ease-out);
  }

  .amenities__photo.is-active {
    opacity: 1;
    transform: none;
  }

  .amenities__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Extras strip */
  .amenities__extras {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line-strong);
  }

  .amenities__extras-title {
    grid-column: 1 / 3;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .amenities__extras-list {
    grid-column: 3 / 13;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem var(--grid-gap);
  }

  .amenities__extras-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--text-small);
    color: var(--color-ink);
  }

  .amenities__extras-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    background: var(--color-cta);
  }

  @media (max-width: 1023px) {
    .amenities__intro,
    .amenities__list {
      grid-column: 1 / 13;
    }

    .amenities__visual {
      display: none;
    }

    .amenities__item {
      grid-template-columns: 2.5rem 1fr 7.5rem;
      align-items: start;
    }

    .amenities__item .amenities__name {
      color: var(--color-ink);
    }

    .amenities__text {
      max-height: none;
      opacity: 1;
      margin-top: 0.5rem;
    }

    .amenities__thumb {
      display: block;
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }

    .amenities__thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .amenities__extras-title {
      grid-column: 1 / 13;
      margin-bottom: var(--space-md);
    }

    .amenities__extras-list {
      grid-column: 1 / 13;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .amenities__item {
      grid-template-columns: 2rem 1fr 5.5rem;
      gap: 0.75rem;
    }

    .amenities__extras-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-amenities]').forEach((list) => {
    const section = list.closest('.amenities');
    const items = Array.from(list.querySelectorAll<HTMLElement>('.amenities__item'));
    const photos = Array.from(section?.querySelectorAll<HTMLElement>('[data-photo]') ?? []);
    const activate = (i: number) => {
      items.forEach((el, k) => el.classList.toggle('is-active', k === i));
      photos.forEach((el, k) => el.classList.toggle('is-active', k === i));
    };
    items.forEach((el, i) => {
      el.addEventListener('mouseenter', () => activate(i));
      el.addEventListener('focus', () => activate(i));
      el.addEventListener('click', () => activate(i));
    });
  });
</script>
